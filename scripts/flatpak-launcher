#!/bin/sh
set -eu
export SDL_VIDEO_X11_WMCLASS=io.github.joaojotta.JottaText
export SDL_VIDEO_WAYLAND_WMCLASS=io.github.joaojotta.JottaText
export SDL_APP_NAME='Jotta Text'
export LITE_USERDIR="${XDG_CONFIG_HOME:-$HOME/.config}/litefront"
/app/bin/jotta-text-migrate-settings "$LITE_USERDIR"
# User storage contains session state, never executable extensions or application code.
mkdir -p "$LITE_USERDIR"
export LITEFRONT_BUNDLED=1
exec /app/bin/lite-xl "$@"
