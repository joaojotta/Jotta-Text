[Desktop Entry]
Type=Application
Name=Jotta Text
Comment=Code, write and preview with built-in tools
Exec=jotta-text %F
Icon=io.github.joaojotta.JottaText
Terminal=false
Categories=Development;IDE;TextEditor;
StartupWMClass=io.github.joaojotta.JottaText
MimeType=text/plain;text/html;text/css;text/x-php;text/markdown;image/png;image/jpeg;image/gif;image/bmp;image/webp;image/svg+xml;image/vnd.microsoft.icon;image/tiff;font/ttf;font/otf;font/collection;font/woff;font/woff2;inode/directory;
